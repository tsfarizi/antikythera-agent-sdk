{
  "name": "antikythera-agent",
  "version": "1.8.5",
  "description": "General-purpose agent runtime with multi-agent orchestration, MCP tool integration, and WebAssembly support",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test ../../../tests/node/session-manager-remove.test.mjs ../../../tests/node/registry-parity.test.mjs ../../../tests/node/hooks-ownership.test.mjs ../../../tests/node/component-base.test.mjs ../../../tests/node/core-module-names.test.mjs ../../../tests/node/orchestrator-node.test.mjs ../../../tests/node/tools.test.mjs ../../../tests/node/runtime-consistency.test.mjs ../../../tests/node/delivery.test.mjs",
    "prepublishOnly": "npm run pack-smoke",
    "pack-smoke": "node ../../../tests/packaging/pack-smoke.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "orchestrator.js",
    "README.md",
    "component",
    "runtime",
    "core",
    "plugin",
    "delivery"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core/index.d.ts",
      "default": "./core/index.js"
    },
    "./plugin": {
      "types": "./plugin/index.d.ts",
      "default": "./plugin/index.js"
    },
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./component": {
      "types": "./component/antikythera-sdk.d.ts",
      "default": "./component/antikythera-sdk.js"
    },
    "./package.json": "./package.json",
    "./component/instantiate": {
      "types": "./component/instantiate.d.ts",
      "default": "./component/instantiate.js"
    },
    "./delivery": {
      "types": "./delivery/index.d.ts",
      "default": "./delivery/index.js"
    }
  },
  "keywords": [
    "agent",
    "runtime",
    "mcp",
    "llm",
    "wasm",
    "multi-agent",
    "orchestration"
  ],
  "author": "tsfarizi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsfarizi/antikythera-agent-sdk"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
