package antikythera:agent-sdk@1.0.0;

/// Shared vocabulary for the host-facing interfaces.
///
/// Records are defined here (canonical WIT requires types to live inside an
/// interface) and imported by the host-imports and tool-registry interfaces.
/// JSON strings carry these records across runner boundaries.
interface vocabulary {
  /// LlmRequest
  record llm-request {
    provider: option<string>,
    model: option<string>,
    session-id: option<string>,
    messages-json: string,
    force-json: bool,
    temperature: option<f32>,
    max-tokens: option<u32>,
    schema-name: option<string>,
    metadata-json: option<string>,
  }

  /// LlmResponse
  record llm-response {
    content: string,
    model: option<string>,
    session-id: option<string>,
    message-json: option<string>,
    tokens-used: option<u32>,
    finish-reason: option<string>,
    raw-response-json: option<string>,
  }

  /// ToolCallEvent
  record tool-call-event {
    tool-name: string,
    arguments-json: string,
    session-id: option<string>,
    step-id: u32,
  }

  /// ToolExecutionResult
  record tool-execution-result {
    tool-name: string,
    success: bool,
    output-json: string,
    error-message: option<string>,
    step-id: u32,
  }

  /// LogEvent
  record log-event {
    level: string,
    message: string,
    timestamp: option<string>,
  }

  /// DelegatingAgent<H: HostImports>
  ///
  /// The original design was generic over a `HostImports` implementation
  /// (`record delegating-agent<-h: -host-imports>`); the WIT dialect used by
  /// wasm-tools 1.256 has no generic type parameters, so `host` carries an
  /// opaque host instance id and the field set is preserved unchanged.
  record delegating-agent {
    host: string,
    session-id: option<string>,
    step-counter: u32,
    max-steps: u32,
  }
}

/// HostImports
interface host-imports {
  use vocabulary.{llm-request, llm-response, tool-call-event, tool-execution-result, log-event};

  call-llm: func(request: llm-request) -> result<llm-response, string>;
  emit-tool-call: func(event: tool-call-event) -> result<tool-execution-result, string>;
  log-message: func(event: log-event);
  save-state: func(context-id: string, state-json: string) -> result<_, string>;
  load-state: func(context-id: string) -> result<option<string>, string>;
}

/// PromptManager — host-side prompt storage interface
interface prompt-manager {
  /// Retrieve a prompt template by its identifier.
  get-prompt: func(prompt-id: string) -> result<option<string>, string>;
  /// List all available prompt identifiers.
  list-prompts: func() -> result<list<string>, string>;
}

/// McpClient — host-side MCP server proxy interface
interface mcp-client {
  use vocabulary.{tool-call-event, tool-execution-result};

  /// List tools exposed by a connected MCP server.
  list-tools: func(server-id: string) -> result<list<tool-call-event>, string>;
  /// Invoke a tool on an MCP server and return the result.
  invoke-tool: func(server-id: string, tool-name: string, input-json: string) -> result<tool-execution-result, string>;
}

/// FfiServer — optional REST bridge for non-WASM hosts
interface ffi-server {
  /// Start the HTTP bridge on the given bind address.
  start: func(bind-address: string) -> result<_, string>;
  /// Gracefully stop the HTTP bridge.
  stop: func() -> result<_, string>;
}

/// Runner — JSON-string agent API exported by the Antikythera WASM component.
///
/// Every function is a thin wrapper over `crate::wasm_agent::runner`; JSON
/// payloads pass through unmodified and errors are flattened to strings.
interface runner {
  /// Initialize the runner from a config JSON string.
  init: func(config-json: string) -> result<string, string>;
  /// Prepare a user turn (prompt building + tool guidance).
  prepare-user-turn: func(request-json: string) -> result<string, string>;
  /// Commit a complete LLM response against a prepared turn.
  commit-llm-response: func(prepared-turn-json: string, llm-response-json: string) -> result<string, string>;
  /// Commit an LLM stream session against a prepared turn.
  commit-llm-stream: func(prepared-turn-json: string) -> result<string, string>;
  /// Process an LLM response for a named session.
  process-llm-response-for-session: func(session-id: string, llm-response-json: string) -> result<string, string>;
  /// Process a tool result for a named session.
  process-tool-result-for-session: func(session-id: string, tool-result-json: string) -> result<string, string>;
  /// Append a streaming LLM chunk to a session.
  append-llm-chunk: func(session-id: string, chunk: string, correlation-id: option<string>) -> result<bool, string>;
  /// Drain pending stream events for a session as JSON.
  drain-events: func(session-id: string) -> result<string, string>;
  /// Snapshot the agent state of a session as JSON.
  get-state: func(session-id: string) -> result<string, string>;
  /// Reset (drop) a session; returns whether it existed.
  reset-session: func(session-id: string) -> result<bool, string>;
  /// Sweep idle sessions; returns the number of sessions reaped.
  sweep-idle-sessions: func(now-unix-ms: option<s64>) -> result<u32, string>;
  /// Register tool definitions; returns the number registered.
  register-tools: func(tools-json: string) -> result<u32, string>;
  /// Return the formatted tool-list prompt block.
  get-tools-prompt: func() -> result<string, string>;
  /// Install the context-policy from a JSON string.
  set-context-policy: func(policy-json: string) -> result<bool, string>;
  /// Snapshot runner telemetry for a session as JSON.
  get-telemetry-snapshot: func(session-id: string) -> result<string, string>;
  /// Snapshot SLO metrics for a session as JSON.
  get-slo-snapshot: func(session-id: string) -> result<string, string>;
}

/// World for the standalone SDK component.
///
/// `tool-registry` and `logic-hooks` are imported and supplied by
/// composition (`wasm-tools compose`); `runner` is exported to the host.
/// `runtime-hooks` is a HOST import: it is NOT supplied by composition.
/// The host wires it at runtime (wasmtime linker on the server, jco import
/// object on the client). The composite therefore imports exactly one
/// non-WASI interface (`runtime-hooks`) plus WASI.
world antikythera-agent-sdk {
  import tool-registry;
  import logic-hooks;
  import runtime-hooks;
  export runner;
}

/// ToolRegistry - stateless tool definition catalog and builtin executor.
///
/// Contract exported by the standalone `antikythera-toolrunner`
/// component and imported by the SDK component; `wasm-tools
/// compose` wires the two. The interface carries no state (D4): every call
/// is self-contained and all payloads travel as JSON strings, consistent
/// with the JSON-string philosophy of `runner`.
interface tool-registry {
  /// List the known tool definitions as a JSON array string.
  ///
  /// Each element is a ToolDefinition JSON object:
  ///   { "name", "title"?, "description", "parameters"?,
  ///     "input_schema"?, "output_schema"? }
  /// The array is sorted by tool name for determinism
  /// (`ToolRegistry::to_json`).
  ///
  /// Ok - JSON array of ToolDefinition.
  /// Err - the registry could not be serialized.
  list-tools-json: func() -> result<string, string>;

  /// Validate a tool call against the registry.
  ///
  /// Ok - the call is valid.
  /// Err(message) - the tool is unknown or a required parameter is missing
  /// (`ToolRegistry::validate_call` failure).
  ///
  /// An empty registry skips validation and accepts any tool, mirroring
  /// `ToolRegistry::validate_call`.
  validate-tool-call: func(tool-name: string, arguments-json: string) -> result<_, string>;

  /// Execute a builtin tool and return its result as a JSON string.
  ///
  /// Ok - JSON ToolResult object:
  ///   { "name", "success", "output", "error"?, "step_id" }
  /// - the exact shape produced by `tool_result_to_json`, identical to the
  ///   SDK's WASM `ToolResult` mirror, so the composite can deserialize it
  ///   without field translation.
  ///
  /// Err - signal, not a tool failure:
  /// - "tool '<name>' requires host execution (not builtin)" means the tool
  ///   has no builtin handler in this component; the caller MUST delegate
  ///   execution to the host (existing `process_tool_result_for_session`
  ///   flow);
  /// - any other message means the call was rejected before execution
  ///   (validation failure or malformed arguments).
  ///
  /// A tool failure is NOT an error: it is returned as Ok with
  /// `success: false` and an `error` message.
  execute-builtin: func(tool-name: string, arguments-json: string, step-id: u32) -> result<string, string>;
}

/// LogicHooks - host-authored plug-and-play pipeline hooks.
///
/// Contract imported by the SDK component and exported by a host-authored
/// hooks component (`logic-hooks-component`); `wasm-tools compose` wires the
/// two, mirroring the `tool-registry` / `antikythera-toolrunner` pair. The
/// SDK runner calls each hook at a fixed pipeline point and uses the returned
/// JSON as the decision for that point:
///
/// - Ok `{"passthrough": true}` - use the SDK default behavior at this point;
///   the passthrough signal is exactly this single-key object, any other JSON
///   object is an override;
/// - Ok <override JSON> - use this value in place of the SDK default; the
///   meaning of the override is defined per function below;
/// - Err(message) - the hook failed; the SDK aborts the operation and
///   surfaces the error to the caller. A failing hook never falls back to
///   passthrough.
///
/// The returned string MUST be a JSON object; an unparseable or non-object
/// return is treated as a hook failure (Err-path semantics).
///
/// Hooks are pure decision functions: they receive inputs and return a
/// decision. Session state is owned by the SDK - it is passed in as
/// `session-state-json` on every call, and hooks MUST NOT persist or mutate
/// it; any state a hook writes is discarded.
interface logic-hooks {
  /// Prepare a user turn (prompt building + tool guidance).
  ///
  /// Invoked at the start of `runner.prepare-user-turn`, after the SDK has
  /// built its default prepared turn.
  ///
  /// - `request-json` - the request payload passed to `prepare-user-turn`.
  /// - `session-state-json` - the session agent-state JSON snapshot.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default prepared turn.
  /// Ok <prepared-turn JSON> - use this JSON as the prepared turn; present
  ///   fields are authoritative, absent fields fall back to the SDK default.
  ///   A hook that appends a message returns the full `messages` array.
  /// Err(message) - abort the turn and surface the error.
  prepare-turn: func(request-json: string, session-state-json: string) -> result<string, string>;

  /// Decide the action for a committed LLM response.
  ///
  /// Invoked by the SDK when an LLM response is committed
  /// (`process-llm-response-for-session`), before the default action
  /// derivation runs.
  ///
  /// - `session-state-json` - the session agent-state JSON snapshot.
  /// - `llm-response-json` - the committed LLM response JSON.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default action decision.
  /// Ok <decision JSON> - override the decision; the SDK commits this value
  ///   as the action result. A hook can force a terminal action (for
  ///   example `final`) by returning the same envelope the SDK produces for
  ///   that action.
  /// Err(message) - abort the operation and surface the error.
  decide-action: func(session-state-json: string, llm-response-json: string) -> result<string, string>;

  /// Handle a tool result before it is committed to the session.
  ///
  /// Invoked by the SDK when a tool result is reported
  /// (`process-tool-result-for-session`), before default processing.
  ///
  /// - `session-state-json` - the session agent-state JSON snapshot.
  /// - `tool-result-json` - the reported tool result JSON.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default tool-result processing.
  /// Ok <tool-result JSON> - use this JSON as the tool result in place of
  ///   the reported one.
  /// Err(message) - abort the operation and surface the error.
  handle-tool-result: func(session-state-json: string, tool-result-json: string) -> result<string, string>;
}

/// RuntimeHooks - host-supplied pipeline hook decisions injected at runtime.
///
/// Contract imported by the SDK component and IMPLEMENTED BY THE HOST
/// (wasmtime linker on the server, jco import object on the client). Unlike
/// `logic-hooks` (wired at build time via `wasm-tools compose`), this
/// interface is wired at runtime: the host provides the three decision
/// functions, and the runner consults them at the same pipeline points as
/// `logic-hooks`.
///
/// Precedence (A1a): the composed `logic-hooks` provider is consulted FIRST;
/// `runtime-hooks` is invoked only when the composed provider returns the
/// passthrough signal. This preserves the behavior of existing consumers:
/// a host-authored composed hook remains authoritative, and the runtime
/// provider only sees pipeline points the composed provider chose not to
/// override.
///
/// Classification semantics are IDENTICAL to `logic-hooks`:
///
/// - Ok `{"passthrough": true}` - use the SDK default behavior at this point;
///   the passthrough signal is exactly this single-key object, any other JSON
///   object is an override;
/// - Ok <override JSON> - use this value in place of the SDK default; the
///   meaning of the override is defined per function below;
/// - Err(message) - the hook failed; the SDK aborts the operation and
///   surfaces the error. A failing hook never falls back to passthrough.
///
/// The returned string MUST be a JSON object; an unparseable or non-object
/// return is treated as a hook failure (Err-path semantics).
///
/// Hooks are pure decision functions: they receive inputs and return a
/// decision. Session state is owned by the SDK - it is passed in as
/// `session-state-json` on every call, and hooks MUST NOT persist or mutate
/// it; any state a hook writes is discarded.
interface runtime-hooks {
  /// Prepare a user turn (prompt building + tool guidance).
  ///
  /// Invoked at the start of `runner.prepare-user-turn`, after the SDK has
  /// built its default prepared turn AND the composed `logic-hooks`
  /// `prepare-turn` has returned passthrough.
  ///
  /// - `request-json` - the request payload passed to `prepare-user-turn`.
  /// - `session-state-json` - the session agent-state JSON snapshot.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default prepared turn.
  /// Ok <prepared-turn JSON> - use this JSON as the prepared turn; present
  ///   fields are authoritative, absent fields fall back to the SDK default.
  /// Err(message) - abort the turn and surface the error.
  prepare-turn: func(request-json: string, session-state-json: string) -> result<string, string>;

  /// Decide the action for a committed LLM response.
  ///
  /// Invoked by the SDK when an LLM response is committed
  /// (`process-llm-response-for-session`), before the default action
  /// derivation runs AND only when the composed `logic-hooks`
  /// `decide-action` has returned passthrough.
  ///
  /// - `session-state-json` - the session agent-state JSON snapshot.
  /// - `llm-response-json` - the committed LLM response JSON.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default action decision.
  /// Ok <decision JSON> - override the decision; the SDK commits this value
  ///   as the action result.
  /// Err(message) - abort the operation and surface the error.
  decide-action: func(session-state-json: string, llm-response-json: string) -> result<string, string>;

  /// Handle a tool result before it is committed to the session.
  ///
  /// Invoked by the SDK when a tool result is reported
  /// (`process-tool-result-for-session`), before default processing AND only
  /// when the composed `logic-hooks` `handle-tool-result` has returned
  /// passthrough.
  ///
  /// - `session-state-json` - the session agent-state JSON snapshot.
  /// - `tool-result-json` - the reported tool result JSON.
  ///
  /// Ok `{"passthrough": true}` - keep the SDK default tool-result processing.
  /// Ok <tool-result JSON> - use this JSON as the tool result in place of
  ///   the reported one.
  /// Err(message) - abort the operation and surface the error.
  handle-tool-result: func(session-state-json: string, tool-result-json: string) -> result<string, string>;
}

/// World for the standalone toolrunner component.
///
/// The component exports the stateless `tool-registry` interface and imports
/// nothing from this package. `wasm-tools compose` wires this export to the
/// SDK component's `import tool-registry;`.
world tool-registry-component {
  export tool-registry;
}

/// World for a host-authored logic-hooks component.
///
/// The component exports the stateless `logic-hooks` interface and imports
/// nothing from this package. `wasm-tools compose` wires this export to the
/// SDK component's `import logic-hooks;`.
world logic-hooks-component {
  export logic-hooks;
}

/// World for a host-authored drop-in logic core component.
///
/// This world defines the contract for a custom `runner` implementation that
/// can replace the composite SDK component (`antikythera-agent-sdk`) without
/// any change to host code. The exported `runner` interface is IDENTICAL to
/// the SDK runner - the same 16 functions with the same JSON-string
/// semantics - so a host calls the same API whether the loaded component is
/// the SDK composite (wasmtime server, jco client) or a custom logic core.
///
/// The imports are OPTIONAL declarations, not requirements:
///
/// - `host-imports` - a logic core that wants to call the host LLM, tool,
///   log, or state services may import this interface and use it. A component
///   that never references it remains valid: unused imports are legal WIT,
///   and the component encoder prunes an import that nothing in the component
///   references, so a self-contained logic core ends up importing nothing.
/// - `tool-registry` - a logic core that wants to reuse the stateless
///   toolrunner catalog and executor (`list-tools-json`,
///   `validate-tool-call`, `execute-builtin`) may import this interface; the
///   same pruning rule applies.
///
/// Both `host-imports` and `tool-registry` live in this same package, so the
/// imports need no dependency declaration - consistent with the other worlds
/// in this file.
world logic-core-component {
  import host-imports;
  import tool-registry;
  export runner;
}
